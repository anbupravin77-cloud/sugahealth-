rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read their own profile. Admins can read all.
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Users can create their own profile initially (role must be 'patient' or missing to default to patient)
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Users can update their own profile (but not their role). Admins can update any profile.
      allow update: if isAuthenticated() && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin()
      );
      
      allow delete: if isAuthenticated() && isAdmin();
    }
    
    // Staff profiles collection
    match /staff_profiles/{userId} {
      // Staff can read their own profile. Admins can read all.
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Only admins can create or delete staff profiles
      allow create, delete: if isAuthenticated() && isAdmin();
      
      // Staff can update their own profile (except sensitive fields). Admins can update all.
      allow update: if isAuthenticated() && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active']))
        || isAdmin()
      );
    }
    
    // Audit logs collection (Server-side creation mostly, admins can read)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if false; // Only written via Admin SDK backend
    }

    // Consultations collection
    match /consultations/{consultationId} {
      // Patients can read their own.
      // Doctors can read assigned consultations or unassigned ones in queue.
      // Admins can read all.
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) || 
        isAdmin() ||
        (getUserRole() == 'doctor' && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.assignedTo == null ||
          resource.data.assignedTo == ''
        ))
      );
      
      // Patients can create a consultation
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      
      // Patients can only update their own if it's a draft, and they can only transition it to submitted or keep it draft.
      // Doctors can assign unassigned consultations to themselves or update draft fields,
      // but COMPLETION must go through backend API (request.resource.data.status != 'completed').
      // Admins can update all.
      allow update: if isAuthenticated() && (
        (
          isOwner(resource.data.patientId) && 
          resource.data.status == 'draft' && 
          request.resource.data.status in ['draft', 'submitted'] &&
          request.resource.data.patientId == resource.data.patientId
        ) || 
        isAdmin() ||
        (
          getUserRole() == 'doctor' &&
          request.resource.data.status != 'completed' &&
          (
            resource.data.assignedTo == request.auth.uid ||
            (
              (resource.data.assignedTo == null || resource.data.assignedTo == '') &&
              request.resource.data.assignedTo == request.auth.uid
            )
          )
        )
      );
      
      allow delete: if false; // Consultations should not be deleted, only cancelled
    }
    // Clinical Notes collection
    match /clinical_notes/{noteId} {
      allow read: if isAuthenticated() && (
        (getUserRole() == 'doctor' && resource.data.doctorId == request.auth.uid) ||
        isAdmin()
      );
      // All writes must go through the backend API for audit logging
      allow write: if false;
    }

    // Prescriptions collection
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        (getUserRole() == 'doctor' && resource.data.doctorId == request.auth.uid) ||
        isOwner(resource.data.patientId) ||
        getUserRole() == 'pharmacist' ||
        isAdmin()
      );
      // All writes must go through the backend API for audit logging
      allow write: if false;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        getUserRole() == 'pharmacist' ||
        isAdmin()
      );
      // All writes must go through the backend API for pricing and audit logging
      allow write: if false;
    }

    // Message Threads
    match /message_threads/{threadId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) || 
        isOwner(resource.data.doctorId)
      );
      allow write: if false; // Only backend API can create/update
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isOwner(get(/databases/$(database)/documents/message_threads/$(threadId)).data.patientId) || 
          isOwner(get(/databases/$(database)/documents/message_threads/$(threadId)).data.doctorId)
        );
        allow write: if false; // Only backend API can create/update
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.patientId);
      allow write: if false; // Only backend API
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        getUserRole() in ['doctor', 'admin']
      );
      allow write: if false; // Only backend API
    }

    // Refill Requests collection
    match /refill_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        getUserRole() in ['doctor', 'admin']
      );
      allow write: if false; // Only backend API
    }
  }
}
