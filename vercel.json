{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sugahealth-api.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://sugahealth-api.onrender.com/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
