# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Required for secure Stripe backend integration.
# Obtain from the Stripe Dashboard (Developers -> API keys).
# Used to verify ownership, initiate checkout, and create payment intents.
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRET: Required to verify asynchronous stripe events securely.
# Obtain from the Stripe Dashboard (Developers -> Webhooks).
# Matches the endpoint configured to hit /api/webhooks/payment
STRIPE_WEBHOOK_SECRET="whsec_..."

# EMAIL_API_KEY: Provider key for sending transactional emails (e.g. SendGrid, Mailgun)
EMAIL_API_KEY=

# SMS_API_KEY: Provider key for sending transactional SMS (e.g. Twilio)
SMS_API_KEY=

